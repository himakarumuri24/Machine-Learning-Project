corr

print(df.columns.tolist())


df.isnull().sum()

df = df.dropna()


X = df[['top_speed_kmh',
        'battery_capacity_kWh',
        'number_of_cells',
        'torque_nm',
        'efficiency_wh_per_km',
        'acceleration_0_100_s',
        'fast_charging_power_kw_dc',
        'towing_capacity_kg',
        'cargo_volume_l',
        'seats',
        'length_mm',
        'width_mm',
        'height_mm']]
y = df['range_km']


from sklearn.model_selection import train_test_split
